NODE_ENV=
PORT=

# Base de données PostgreSQL — connection string complète
DATABASE_URL=

# CORS (origines supplémentaires autorisées, séparées par des virgules)
CORS_ORIGINS=

# =============================================================================
# Services externes (liens à jour du projet, août 2026)
# =============================================================================
ANAPATH_SERVICE_ID=

# CHU & Prise en charge : https://chu-service-cms7.onrender.com
# (Swagger : /chu/api/docs — routes réelles à la racine : /chu, /prise-en-charge)
CHU_CMS_SERVICE_URL=

# Services (registre des services du CHU) : https://service-service-0f7p.onrender.com
# (Swagger : /services/api/docs — routes réelles à la racine : /services, /services/{id})
# Source du « Service demandeur » (serviceIdSource d'une prescription).
SERVICE_SERVICE_URL=

# Accueil patients (admission) — backend Render (l'ancien Railway est arrêté).
# Patients résolus via GET /accueil/patients/{id}?chuId=…
ACCUEIL_BASE_URL=
# Optionnel : token de service pour Accueil. Laisser vide tant qu'Accueil est
# ouvert ; à renseigner uniquement si Accueil impose un JWT sur /accueil/patients.
ACCUEIL_SERVICE_TOKEN=

# Service Prescription (GET prescriptions anapath + PATCH statut d'une demande).
# Exige un Bearer JWT — celui de l'utilisateur connecté est forwardé pour les
# actions synchrones ; PRESCRIPTION_CRON_JWT sert uniquement au cron de pull
# périodique (pas d'utilisateur connecté dans ce contexte).
PRESCRIPTION_SERVICE_URL=
PRESCRIPTION_SYNC_ENABLED=
PRESCRIPTION_SYNC_CRON=
# Repli si aucun compte de service n'est configuré ci-dessous : JWT de session (~24h),
# à renouveler manuellement. Préférer AUTH_SERVICE_URL + PRESCRIPTION_SERVICE_ACCOUNT_*.
PRESCRIPTION_CRON_JWT=
# Temps réel WebSocket (Socket.IO /notifications).
PRESCRIPTION_WS_ENABLED=

# Compte de service dédié (recommandé) : renouvelle automatiquement le token ci-dessus
# via POST /auth/login — plus besoin de coller un JWT manuellement toutes les ~24h.
# Créer un utilisateur dédié (pas un compte personnel) avec accès au service Anapath.
# Auth : https://auth-service-4q6g.onrender.com (Swagger : /auth/api/docs)
AUTH_SERVICE_URL=
PRESCRIPTION_SERVICE_ACCOUNT_EMAIL=
PRESCRIPTION_SERVICE_ACCOUNT_PASSWORD=

# Service Notification dédié : https://service-notification-nlqp.onrender.com
# (Swagger : /notification/api/docs). Aucune auth requise.
NOTIFICATION_SERVICE_URL=

# Écosystème d'authentification partagé (auth-service / user-services)
# Users : https://user-services-0sze.onrender.com (Swagger : /users/api/docs)
AUTH_ANAPATH_SERVICE_ID=
USER_SERVICES_URL=
AUTH_TOKEN_CACHE_TTL_MS=
AUTH_VALIDATE_TIMEOUT_MS=

# Service d'upload (photos de profil, pièces jointes) : https://service-upload-u5z9.onrender.com
# (Swagger : /upload/api/docs). Auth = JWT utilisateur forwardé par défaut ;
# UPLOAD_API_KEY (x-api-key) seulement si tu veux un accès service.
UPLOAD_SERVICE_URL=
UPLOAD_API_KEY=

# -----------------------------------------------------------------------------
# Services de l'écosystème NON consommés par anapath (référence / futurs liens)
# -----------------------------------------------------------------------------
# Dossier patient : https://dossier-patient-back-ri3e.onrender.com (Swagger : /dossier-patient/api/docs)
# DOSSIER_PATIENT_URL=
# Hospitalisation (clinique) : https://clinique-back-2u7s.onrender.com (Swagger : /clinique/api/docs)
# CLINIQUE_URL=
