NODE_ENV=
PORT=

# Base de données PostgreSQL — connection string complète
DATABASE_URL=

# CORS (origines supplémentaires autorisées, séparées par des virgules)
CORS_ORIGINS=

# =============================================================================
# Gateway central — point d'entrée unique de tous les microservices du CHU
# =============================================================================
# Tous les services (Auth, Users, CHU, Services, Dossier-patient, Accueil,
# Upload, Prescription, Notification, etc.) sont accessibles via le gateway.
# Exemple : gateway-bwm4.onrender.com/auth/login → auth-service
GATEWAY_URL=
ANAPATH_SERVICE_ID=

# Pull de rattrapage (cron) et temps réel — mettre false pour désactiver
PRESCRIPTION_SYNC_ENABLED=
PRESCRIPTION_SYNC_CRON=
PRESCRIPTION_WS_ENABLED=

# Compte de service dédié : renouvelle automatiquement le token via POST /auth/login
PRESCRIPTION_SERVICE_ACCOUNT_EMAIL=
PRESCRIPTION_SERVICE_ACCOUNT_PASSWORD=

# Écosystème d'authentification partagé (auth-service / user-services)
AUTH_ANAPATH_SERVICE_ID=

# Upload API key (optionnel — accès service si JWT utilisateur pas suffisant)
UPLOAD_API_KEY=

# -----------------------------------------------------------------------------
# Services de l'écosystème NON consommés par anapath (référence / futurs liens)
# -----------------------------------------------------------------------------
# Hospitalisation (clinique) : https://clinique-back-2u7s.onrender.com (Swagger : /clinique/api/docs)
# CLINIQUE_URL=
