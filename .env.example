NODE_ENV=
PORT=

# Base de données PostgreSQL — connection string complète
DATABASE_URL=
# Alternative : variables décomposées (utilisées si DATABASE_URL absente)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# CORS (origines supplémentaires autorisées, séparées par des virgules)
CORS_ORIGINS=

# =============================================================================
# Passerelle unique du CHU — point d'entrée réseau prioritaire pour tous les
# services externes ci-dessous (accueil, users, chu, prescriptions,
# notifications, upload, services...). Les *_URL individuelles qui suivent ne
# servent plus que de repli si GATEWAY_URL est absent (dev/debug uniquement).
# =============================================================================
GATEWAY_URL=

# Secret HS256 partagé avec le SSO (auth-service) — DOIT être le même secret
# que celui qui signe réellement les JWT utilisateurs (partagé avec la
# gateway et les autres services de l'écosystème). Utilisé pour signer à la
# volée un jeton de service (AuthServiceTokenService) quand aucune requête
# utilisateur n'est disponible : cron de pull des prescriptions, WebSocket
# temps réel, repli dans AnapathService.resolveTokens. Remplace l'ancien
# mécanisme à base de compte de service dédié (email/mot de passe stockés en
# variable d'environnement), abandonné : des identifiants qui peuvent être
# changés/révoqués par l'IT sans préavis ne sont pas fiables en production.
JWT_SECRET=

# Identité propre de ce service dans le registre multi-service — PAS une
# donnée dupliquée depuis un token : c'est la valeur de référence à laquelle
# le token de CHAQUE utilisateur appelant est comparé (AuthClient.validateToken
# vérifie que payload.services[].serviceId === AUTH_ANAPATH_SERVICE_ID), et la
# valeur avec laquelle ce service se présente/filtre auprès des services
# externes (ANAPATH_SERVICE_ID, ex. serviceIdDest lors du pull des
# prescriptions). Les deux variables portent la même valeur (id du service
# Anapath dans le registre) — gardées séparées pour ne pas coupler
# AuthClient à AnapathService.
ANAPATH_SERVICE_ID=
AUTH_ANAPATH_SERVICE_ID=

# =============================================================================
# Repli si GATEWAY_URL est absent (déploiement direct service-à-service —
# à éviter en production, gardé pour dev/debug uniquement)
# =============================================================================
CHU_CMS_SERVICE_URL=
SERVICE_SERVICE_URL=
ACCUEIL_BASE_URL=
PRESCRIPTION_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
USER_SERVICES_URL=
UPLOAD_SERVICE_URL=

# Optionnel : token de service pour Accueil. Laisser vide tant qu'Accueil est
# ouvert ; à renseigner uniquement si Accueil impose un JWT sur /accueil/patients.
ACCUEIL_SERVICE_TOKEN=

# Pull des prescriptions anapath depuis le service Prescription externe —
# seul mécanisme qui alimente la base locale (aucun endpoint interactif ne
# déclenche de pull à la demande). Désactiver ces deux variables revient à
# ne plus jamais recevoir de nouvelle prescription tant qu'elles restent à
# false, quel que soit le nombre d'utilisateurs connectés ensuite.
PRESCRIPTION_SYNC_ENABLED=
PRESCRIPTION_SYNC_CRON=
# Temps réel WebSocket (Socket.IO /notifications) — accélère la remontée
# entre deux pulls du cron, ne remplace pas PRESCRIPTION_SYNC_ENABLED.
PRESCRIPTION_WS_ENABLED=

AUTH_TOKEN_CACHE_TTL_MS=
AUTH_VALIDATE_TIMEOUT_MS=

# Service d'upload (photos de profil, pièces jointes).
# Auth = JWT utilisateur forwardé par défaut ; UPLOAD_API_KEY (x-api-key)
# seulement si tu veux un accès service.
UPLOAD_API_KEY=

# -----------------------------------------------------------------------------
# Services de l'écosystème NON consommés par anapath (référence / futurs liens)
# -----------------------------------------------------------------------------
# Dossier patient : /dossier-patient (via GATEWAY_URL)
# Hospitalisation (clinique) : /clinique (via GATEWAY_URL)
