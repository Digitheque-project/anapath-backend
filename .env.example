NODE_ENV=
PORT=

# Base de données PostgreSQL — connection string complète (prioritaire)
DATABASE_URL=
# Alternative : variables décomposées (utilisées si DATABASE_URL absente)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# CORS (origines supplémentaires autorisées, séparées par des virgules)
CORS_ORIGINS=

# =============================================================================
# Gateway central — point d'entrée unique de tous les microservices du CHU
# =============================================================================
# Tous les services (Auth, Users, CHU, Services, Dossier-patient, Accueil,
# Upload, Prescription, Notification, etc.) sont accessibles via le gateway.
# Exemple : gateway-bwm4.onrender.com/auth/login → auth-service
GATEWAY_URL=

# Pull de rattrapage (cron) et temps réel — mettre false pour désactiver
PRESCRIPTION_SYNC_ENABLED=
PRESCRIPTION_SYNC_CRON=
PRESCRIPTION_WS_ENABLED=

# Secret HS256 partagé avec le SSO (auth-service) — DOIT être le même secret
# que celui qui signe réellement les JWT utilisateurs (partagé avec la
# gateway et les autres services de l'écosystème). Utilisé pour signer à la
# volée un jeton de service (AuthServiceTokenService) quand aucune requête
# utilisateur n'est disponible : cron de pull des prescriptions, WebSocket
# temps réel, repli dans AnapathService.resolveTokens. Remplace l'ancien
# mécanisme à base de compte de service dédié (email/mot de passe stockés en
# variable d'environnement), abandonné : des identifiants qui peuvent être
# changés/révoqués par l'IT sans préavis ne sont pas fiables en production.
JWT_SECRET=

# Identité propre de ce service dans le registre multi-service : id du service
# Anapath dans le registre. ANAPATH_SERVICE_ID sert à se présenter/filter auprès
# des services externes (ex. serviceIdDest lors du pull des prescriptions) ;
# AUTH_ANAPATH_SERVICE_ID est la valeur de référence à laquelle le serviceId de
# chaque token utilisateur appelant est comparé. Les deux portent la même valeur.
ANAPATH_SERVICE_ID=
AUTH_ANAPATH_SERVICE_ID=

# Upload API key (optionnel — accès service si JWT utilisateur pas suffisant)
UPLOAD_API_KEY=

# -----------------------------------------------------------------------------
# Services de l'écosystème NON consommés par anapath (référence / futurs liens)
# -----------------------------------------------------------------------------
# Hospitalisation (clinique) : https://clinique-back-2u7s.onrender.com (Swagger : /clinique/api/docs)
# CLINIQUE_URL=
